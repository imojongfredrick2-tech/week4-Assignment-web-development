:root {
	--brand-color: #4f46e5;
	--accent-color: #14b8a6;
	--background-color: #f5f7fb;
	--surface-color: #ffffff;
	--primary-text: #1e293b;
	--secondary-text: #64748b;
	--border-color: #e2e8f0;
	--success-color: #16a34a;
	--shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
	font-family: Arial, sans-serif;
	background: var(--background-color);
	color: var(--primary-text);
	line-height: 1.6;
}

.dashboard { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; }
.sidebar {
	background: var(--surface-color);
	padding: 30px 20px;
	border-right: 1px solid var(--border-color);
	display: flex;
	flex-direction: column;
	gap: 35px;
}
.logo { color: var(--brand-color); font-size: 28px; font-weight: bold; }
.navigation { display: flex; flex-direction: column; gap: 10px; }
.nav-link {
	display: flex;
	align-items: center;
	gap: 12px;
	padding: 12px 15px;
	text-decoration: none;
	color: var(--secondary-text);
	border-radius: 10px;
	transition: background 200ms ease, color 200ms ease;
}
.nav-link:hover, .nav-link.active { background: var(--brand-color); color: white; }
.sidebar-footer { margin-top: auto; color: var(--secondary-text); font-size: 14px; }
.main-content { padding: 30px; min-width: 0; }
.header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 20px;
	margin-bottom: 30px;
}
.welcome h1 { font-size: 28px; margin-bottom: 5px; }
.welcome p { color: var(--secondary-text); }
.profile { display: flex; align-items: center; gap: 12px; font-weight: 600; }
.notification { font-size: 22px; }
.avatar {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 42px;
	height: 42px;
	border-radius: 50%;
	background: var(--brand-color);
	color: white;
	font-weight: bold;
}
.summary {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 20px;
	margin-bottom: 35px;
}
.summary > div {
	background: var(--surface-color);
	padding: 22px;
	border-radius: 14px;
	box-shadow: var(--shadow);
}
.summary p { color: var(--secondary-text); font-size: 14px; margin-bottom: 8px; }
.summary h2 { font-size: 24px; color: var(--brand-color); }
.section-heading {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 15px;
	margin-bottom: 20px;
}
.section-heading p { color: var(--secondary-text); font-size: 14px; }
.card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
.category-card {
	background: var(--surface-color);
	border: 1px solid var(--border-color);
	border-radius: 16px;
	padding: 22px;
	display: flex;
	flex-direction: column;
	gap: 10px;
	box-shadow: var(--shadow);
	transition: transform 200ms ease, box-shadow 200ms ease;
}
.category-card:hover, .category-card:focus-visible {
	transform: translateY(-4px);
	box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
}
.category-card:focus-visible { outline: 3px solid var(--brand-color); outline-offset: 3px; }
.card-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 5px; }
.card-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 50px;
	height: 50px;
	border-radius: 12px;
	background: var(--background-color);
	font-size: 25px;
}
.status { font-size: 12px; color: var(--success-color); background: #dcfce7; padding: 5px 10px; border-radius: 20px; }
.savings-status { color: #0f766e; background: #ccfbf1; }
.category-card h3 { font-size: 18px; }
.amount { font-size: 23px; font-weight: bold; color: var(--primary-text); }
.description, .percentage { font-size: 13px; color: var(--secondary-text); }
.progress { width: 100%; height: 8px; background: var(--border-color); border-radius: 10px; overflow: hidden; margin-top: 5px; }
.progress-fill { height: 100%; border-radius: 10px; }
.food { width: 71%; background: #f59e0b; }
.transport { width: 50%; background: #3b82f6; }
.rent { width: 100%; background: #8b5cf6; }
.entertainment { width: 50%; background: #ec4899; }
.savings { width: 67%; background: var(--accent-color); }
.utilities { width: 63%; background: #f97316; }
.footer { margin-top: 40px; text-align: center; color: var(--secondary-text); font-size: 13px; }

@media (max-width: 767px) {
	.dashboard { grid-template-columns: 1fr; }
	.sidebar { border-right: none; border-bottom: 1px solid var(--border-color); padding: 20px; gap: 20px; }
	.navigation { flex-direction: row; flex-wrap: wrap; }
	.nav-link { padding: 10px; font-size: 14px; }
	.sidebar-footer { margin-top: 0; }
	.main-content { padding: 20px; }
	.header { flex-direction: column; align-items: flex-start; }
	.profile { flex-wrap: wrap; }
	.summary, .card-grid { grid-template-columns: 1fr; }
	.section-heading { flex-direction: column; align-items: flex-start; }
}

@media (prefers-color-scheme: dark) {
	:root {
		--brand-color: #818cf8;
		--accent-color: #2dd4bf;
		--background-color: #0f172a;
		--surface-color: #1e293b;
		--primary-text: #f1f5f9;
		--secondary-text: #cbd5e1;
		--border-color: #334155;
		--success-color: #4ade80;
		--shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
	}
}
